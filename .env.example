# ═══════════════════════════════════════════════════════════════════════════════
# ORDERLY — Variables de entorno de producción
# Copia este archivo como .env y rellena los valores marcados con CHANGE_ME
# NUNCA subas el .env real a git
# ═══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=orderly_user
POSTGRES_PASSWORD=CHANGE_ME_usa_password_muy_fuerte

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password_fuerte

# ── JWT (mínimo 64 caracteres aleatorios) ────────────────────────────────────
ORDERLY_JWT_SECRET=CHANGE_ME_genera_con_openssl_rand_hex_64
ORDERLY_JWT_VALIDITY_MINUTES=60

# ── Contraseñas de cuentas seed ───────────────────────────────────────────────
ORDERLY_SUPERADMIN_PASSWORD=CHANGE_ME_superadmin_password
ORDERLY_ADMIN_PASSWORD=CHANGE_ME_admin_password
ORDERLY_OPERATOR_PASSWORD=CHANGE_ME_operator_password

# ── CORS (solo HTTPS en producción) ──────────────────────────────────────────
ORDERLY_CORS_ORIGINS=https://orderlymyapp.com

# ── Trusted Proxy IPs (nginx Docker gateway) ──────────────────────────────────
# Permite al backend confiar en X-Forwarded-For de nginx para rate limiting real.
# Obtener con: docker inspect orderly-frontend | grep Gateway
# Generalmente 172.17.0.1 o la IP de la red orderly-network
ORDERLY_TRUSTED_PROXY_IPS=172.18.0.1

# ── Evolution API ─────────────────────────────────────────────────────────────
EVOLUTION_API_KEY=CHANGE_ME_clave_api_evolution
EVOLUTION_PUBLIC_URL=http://TU_IP_DROPLET:8085
EVOLUTION_WEBHOOK_SECRET=CHANGE_ME_webhook_secret
APP_BASE_URL=http://backend:8080

# ── Email SMTP ────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=support@orderlymyapp.com
MAIL_PASSWORD=CHANGE_ME_app_password_gmail
MAIL_FROM=support@orderlymyapp.com
MAIL_FROM_NAME=Orderly
MAIL_ENABLED=true
APP_FRONTEND_URL=http://TU_IP_DROPLET

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_SUCCESS_URL=http://TU_IP_DROPLET/billing?success=true
STRIPE_CANCEL_URL=http://TU_IP_DROPLET/billing?cancelled=true
STRIPE_PORTAL_RETURN_URL=http://TU_IP_DROPLET/billing
STRIPE_PRICE_STARTER_MONTHLY=price_CHANGE_ME
STRIPE_PRICE_STARTER_ANNUAL=price_CHANGE_ME
STRIPE_PRICE_GROWTH_MONTHLY=price_CHANGE_ME
STRIPE_PRICE_GROWTH_ANNUAL=price_CHANGE_ME
STRIPE_PRICE_BUSINESS_MONTHLY=price_CHANGE_ME
STRIPE_PRICE_BUSINESS_ANNUAL=price_CHANGE_ME
